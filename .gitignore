# ============================================================
# SUPMS-Fair: sec hospital (Express + React) — .gitignore
# ============================================================

# --- Secrets (NEVER commit) ---
backend/.env
.env
.env.local
.env.*.local

# --- Node dependencies ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Logs & runtime files ---
*.log
backend/error.log
backend/all_appts.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Upload storage (patient files — real PHI risk) ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Build output ---
frontend/build/
dist/

# --- Scaffolding/helper scripts generated during development ---
backend/setup_dirs.js
backend/update.js
backend/update_routes.js
backend/verify_project.js
backend/test_audit_logs.js
backend/test_hmac_integrity.js
frontend/src/update_app.js
frontend/src/update_frontend.js

# --- IDE & OS artefacts ---
.vscode/
.idea/
.qoder/
.DS_Store
Thumbs.db
